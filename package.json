{
  "name": "chess.ts",
  "version": "0.16.2",
  "license": "BSD-2-Clause",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "homepage": "https://github.com/lubert/chess.ts",
  "keywords": [
    "chess"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lubert/chess.ts.git"
  },
  "devDependencies": {
    "@microsoft/api-documenter": "^7.8.21",
    "@microsoft/api-extractor": "^7.58.2",
    "@types/jest": "^26.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "api": "npm run build && api-extractor run --local --verbose",
    "build": "tsup",
    "build:docs": "npm run api && api-documenter markdown --input ./temp --output ./docs",
    "lint": "prettier --write . && eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "prepare": "npm run build && husky",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "treenode.ts": "^0.9.0"
  }
}
